        title: "sein",
        speechBase: "sein",
        defaultFolder: "المفضلة",
        forms: {
          ich: '<span class="irregular-letter">bin</span>',
          du: '<span class="irregular-letter">bist</span>',
          er: '<span class="irregular-letter">ist</span>',
          wir: '<span class="irregular-letter">sind</span>',
          ihr: '<span class="irregular-letter">seid</span>',
          sie: '<span class="irregular-letter">sind</span>'
        },
        plainForms: {
          ich: "ich bin",
          du: "du bist",
          er: "er es sie ist",
          wir: "wir sind",
          ihr: "ihr seid",
          sie: "sie sind"
        }
      }
    };

    let activeVerbKey = "möchte";

    // --- State: Folders & Saved Verbs in Arabic ---
    let folders = ["المفضلة", "أفعال غير منتظمة", "أفعال A1 / A2", "أفعال الكيفية (Modalverben)"];
    let currentOpenFolder = null; // null: level 1 (folders), string: level 2 (verbs inside folder)
    
    let savedVerbs = [
      { key: "möchte", folder: "أفعال الكيفية (Modalverben)" },
      { key: "essen", folder: "أفعال غير منتظمة" },
      { key: "können", folder: "أفعال الكيفية (Modalverben)" },
      { key: "haben", folder: "المفضلة" }
    ];

    function isVerbSaved(verbKey) {
      return savedVerbs.some(item => item.key === verbKey);
    }

    function toggleSaveVerb(verbKey) {
      const idx = savedVerbs.findIndex(item => item.key === verbKey);
      if (idx > -1) {
        savedVerbs.splice(idx, 1);
      } else {
        const verbData = verbDataStore[verbKey];
        const targetFolder = currentOpenFolder || (verbData?.defaultFolder || "المفضلة");
        savedVerbs.push({
          key: verbKey,
          folder: targetFolder
        });
      }
      updateUI();
    }

    function updateStarState() {
      const isSaved = isVerbSaved(activeVerbKey);
      const icon = document.getElementById("bookmark-icon");
      const btn = document.getElementById("toggle-bookmark-btn");

      if (isSaved) {
        icon.classList.remove("text-neutral-300", "fill-none");
        icon.classList.add("text-[#FFC700]", "fill-[#FFC700]");
        btn.setAttribute("aria-label", "إزالة من المجلدات");
        btn.setAttribute("title", "إزالة من المجلدات");
      } else {
        icon.classList.remove("text-[#FFC700]", "fill-[#FFC700]");
        icon.classList.add("text-neutral-300", "fill-none");
        btn.setAttribute("aria-label", "إضافة إلى المجلدات");
        btn.setAttribute("title", "إضافة إلى المجلدات");
      }
    }

    function updateBadge() {
      const badge = document.getElementById("saved-counter-badge");
      if (badge) badge.textContent = savedVerbs.length;
    }

    // Slide between Level 1 and Level 2
    function setDrawerView(level, folderName = null) {
      const slider = document.getElementById("drawer-slider");
      if (level === 2 && folderName) {
        currentOpenFolder = folderName;
        slider.style.transform = "translateX(-50%)";
        renderFolderDetail(folderName);
      } else {
        currentOpenFolder = null;
        slider.style.transform = "translateX(0%)";
        renderFolders();
      }
    }

    // LEVEL 1: Render Folder List
    function renderFolders() {
      const container = document.getElementById("folders-list-container");
      const countHeader = document.getElementById("total-folders-count");
      if (countHeader) countHeader.textContent = `${folders.length} مجلدات`;
      if (!container) return;

      if (folders.length === 0) {
        container.innerHTML = `
          <div class="py-12 text-center text-neutral-400 text-xs">
            لا توجد مجلدات حالياً.
          </div>
        `;
        return;
      }

      container.innerHTML = folders.map(f => {
        const count = savedVerbs.filter(v => v.folder === f).length;
        return `
          <div class="folder-row flex items-center justify-between p-3 rounded-lg hover:bg-neutral-50 border border-neutral-100 hover:border-amber-200 cursor-pointer transition group" data-folder="${f}">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="material-symbols-outlined text-[20px] text-amber-500">folder</span>
              <span class="text-sm font-semibold text-neutral-800 truncate">${f}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs text-neutral-400 bg-neutral-100 px-2 py-0.5 rounded-full font-medium">${count} أفعال</span>
              <span class="material-symbols-outlined text-neutral-300 group-hover:text-neutral-600 text-lg transition">chevron_right</span>
            </div>
          </div>
        `;
      }).join('');

      container.querySelectorAll(".folder-row").forEach(row => {
        row.addEventListener("click", () => {
          const folder = row.getAttribute("data-folder");
          setDrawerView(2, folder);
        });
      });
    }

    // LEVEL 2: Render Verbs Inside Folder
    function renderFolderDetail(folderName) {
      const heading = document.getElementById("current-folder-heading");
      const countEl = document.getElementById("folder-verbs-count");
      const container = document.getElementById("folder-verbs-list");
      const addCurrentBtn = document.getElementById("btn-add-current-to-active-folder");

      if (heading) heading.textContent = folderName;

      const verbsInFolder = savedVerbs.filter(v => v.folder === folderName);
      if (countEl) countEl.textContent = `${verbsInFolder.length} أفعال`;

      // Update button to add/remove active verb in this specific folder
      const isCurrentInFolder = verbsInFolder.some(v => v.key === activeVerbKey);
      if (addCurrentBtn) {
        const activeData = verbDataStore[activeVerbKey];
        const displayVerb = activeData ? activeData.title : activeVerbKey;
        if (isCurrentInFolder) {
          addCurrentBtn.innerHTML = `<span class="text-neutral-400">✓</span> <span>„${displayVerb}“ موجود بالفعل</span>`;
          addCurrentBtn.classList.remove("text-amber-900");
          addCurrentBtn.classList.add("text-neutral-500");
        } else {
          addCurrentBtn.innerHTML = `<span class="text-amber-600 font-bold">+</span> <span>إضافة „${displayVerb}“</span>`;
          addCurrentBtn.classList.remove("text-neutral-500");
          addCurrentBtn.classList.add("text-amber-900");
        }
      }

      if (verbsInFolder.length === 0) {
        container.innerHTML = `
          <div class="py-14 flex flex-col items-center justify-center text-center text-neutral-400">
            <span class="material-symbols-outlined text-3xl text-neutral-300 mb-1">folder_open</span>
            <p class="text-xs text-neutral-500 font-medium">هذا المجلد فارغ حالياً</p>
            <p class="text-[11px] text-neutral-400 mt-1">اضغط على الزر أعلاه لإضافة الفعل الحالي.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = verbsInFolder.map(item => {
        const data = verbDataStore[item.key];
        const title = data ? data.title : item.key;
        const isActive = item.key === activeVerbKey;

        return `
          <div class="flex items-center justify-between p-2.5 rounded-lg border ${isActive ? 'bg-[#FFE788]/20 border-[#FFC700]' : 'bg-white border-neutral-100 hover:border-amber-200'} transition group">
            <button type="button" class="btn-select-verb flex-1 text-left flex items-center gap-2 min-w-0 focus:outline-none" data-verb="${item.key}">
              <span class="text-sm font-semibold text-neutral-800 hover:text-amber-700 transition truncate">${title}</span>
              ${isActive ? '<span class="text-[10px] bg-[#FFE788] px-1.5 py-0.5 rounded font-bold text-neutral-900">نشط</span>' : ''}
            </button>
            <button type="button" class="btn-remove-verb p-1 text-neutral-300 hover:text-red-500 rounded transition" data-verb="${item.key}" title="إزالة من المجلد">
              <span class="material-symbols-outlined text-[17px]">close</span>
            </button>
          </div>
        `;
      }).join('');

      // Click verb to immediately show in flashcard
      container.querySelectorAll(".btn-select-verb").forEach(btn => {
        btn.addEventListener("click", () => {
          const verb = btn.getAttribute("data-verb");
          renderVerb(verb);
          renderFolderDetail(folderName);
        });
      });

      // Remove verb from folder
      container.querySelectorAll(".btn-remove-verb").forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const verb = btn.getAttribute("data-verb");
          const idx = savedVerbs.findIndex(v => v.key === verb && v.folder === folderName);
          if (idx > -1) {
            savedVerbs.splice(idx, 1);
            updateUI();
            renderFolderDetail(folderName);
          }
        });
      });
    }

    function updateUI() {
      updateStarState();
      updateBadge();
      if (currentOpenFolder) {
        renderFolderDetail(currentOpenFolder);
      } else {
        renderFolders();
      }
    }

    function renderVerb(verbKey) {
      const normalizedKey = verbKey.toLowerCase().replace(/[„“"']/g, '').trim();
      const data = verbDataStore[normalizedKey];
      
      if (!data) {
        alert(`لم يتم العثور على الفعل "${verbKey}". الأفعال المتاحة: möchte, essen, nehmen, können, wollen, sprechen, sehen, haben, sein.`);
        return;
      }

      activeVerbKey = normalizedKey;

      // Update Header Pill
      const titleElem = document.getElementById("card-verb-title");
      titleElem.textContent = data.title;

      // Update rows with highlighted irregular letters
      document.getElementById("row-ich").innerHTML = data.forms.ich;
      document.getElementById("row-du").innerHTML = data.forms.du;
      document.getElementById("row-er").innerHTML = data.forms.er;
      document.getElementById("row-wir").innerHTML = data.forms.wir;
      document.getElementById("row-ihr").innerHTML = data.forms.ihr;
      document.getElementById("row-sie").innerHTML = data.forms.sie;

      // Highlight active button state in the bottom pills
      document.querySelectorAll(".verb-btn").forEach(btn => {
        const btnVerb = btn.getAttribute("data-verb");
        if (btnVerb === normalizedKey) {
          btn.classList.add("bg-[#FFC700]", "border-[#FFC700]", "text-black");
          btn.classList.remove("bg-white", "border-amber-300", "text-neutral-800");
        } else {
          btn.classList.remove("bg-[#FFC700]", "border-[#FFC700]", "text-black");
          btn.classList.add("bg-white", "border-amber-300", "text-neutral-800");
        }
      });

      updateStarState();
      if (currentOpenFolder) {
        renderFolderDetail(currentOpenFolder);
      }
    }

    function pronounceText(text) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'de-DE';
        utterance.rate = 0.9;
        window.speechSynthesis.speak(utterance);
      }
    }

    // Drawer Slide Handlers
    function openDrawer() {
      const container = document.getElementById("saved-drawer-container");
      const backdrop = document.getElementById("drawer-backdrop");
      const panel = document.getElementById("drawer-panel");

      container.classList.remove("pointer-events-none");
      backdrop.classList.remove("opacity-0");
      backdrop.classList.add("opacity-100");
      panel.classList.remove("translate-x-full");
      panel.classList.add("translate-x-0");
      setDrawerView(1);
    }

    function closeDrawer() {
      const container = document.getElementById("saved-drawer-container");
      const backdrop = document.getElementById("drawer-backdrop");
      const panel = document.getElementById("drawer-panel");

      backdrop.classList.remove("opacity-100");
      backdrop.classList.add("opacity-0");
      panel.classList.remove("translate-x-0");
      panel.classList.add("translate-x-full");

      setTimeout(() => {
        container.classList.add("pointer-events-none");
        setDrawerView(1);
      }, 350);
    }

    document.addEventListener("DOMContentLoaded", () => {
      renderVerb("möchte");
      updateUI();

      // Bookmark / Star Button Toggle
      const starBtn = document.getElementById("toggle-bookmark-btn");
      if (starBtn) {
        starBtn.addEventListener("click", () => {
          toggleSaveVerb(activeVerbKey);
        });
      }

      // Drawer Open & Close
      document.getElementById("open-saved-btn")?.addEventListener("click", openDrawer);
      document.getElementById("close-saved-btn")?.addEventListener("click", closeDrawer);
      document.getElementById("close-saved-btn-sub")?.addEventListener("click", closeDrawer);
      document.getElementById("drawer-backdrop")?.addEventListener("click", closeDrawer);

      // Back navigation to Folders level
      document.getElementById("btn-back-to-folders")?.addEventListener("click", () => {
        setDrawerView(1);
      });

      // Add currently loaded verb into current open folder
      document.getElementById("btn-add-current-to-active-folder")?.addEventListener("click", () => {
        if (!currentOpenFolder) return;
        const exists = savedVerbs.some(v => v.key === activeVerbKey && v.folder === currentOpenFolder);
        if (!exists) {
          savedVerbs.push({
            key: activeVerbKey,
            folder: currentOpenFolder
          });
        } else {
          const idx = savedVerbs.findIndex(v => v.key === activeVerbKey && v.folder === currentOpenFolder);
          if (idx > -1) savedVerbs.splice(idx, 1);
        }
        updateUI();
      });

      // Add New Folder
      document.getElementById("btn-add-folder")?.addEventListener("click", () => {
        const folderName = prompt("اسم المجلد الجديد (مثال: أفعال B1، تصريفات القواعد):");
        if (folderName && folderName.trim()) {
          const clean = folderName.trim();
          if (!folders.includes(clean)) {
            folders.push(clean);
            setDrawerView(2, clean);
          } else {
            setDrawerView(2, clean);
          }
        }
      });

      // Quick buttons under table click
      document.querySelectorAll(".verb-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          const verb = btn.getAttribute("data-verb");
          renderVerb(verb);
        });
      });

      // Minimal search input
      const searchInput = document.getElementById("verb-search-input");
      const searchBtn = document.getElementById("btn-search-trigger");

      const executeSearch = () => {
        const val = searchInput.value.trim();
        if (val) {
          renderVerb(val);
          searchInput.value = "";
        }
      };

      searchBtn?.addEventListener("click", executeSearch);
      searchInput?.addEventListener("keydown", (e) => {
        if (e.key === "Enter") executeSearch();
      });

      // Row click sound readout
      const rowIds = [
        { selector: '[data-pronoun="ich"]', key: "ich" },
        { selector: '[data-pronoun="du"]', key: "du" },
        { selector: '[data-pronoun="er, es, sie"]', key: "er" },
        { selector: '[data-pronoun="wir"]', key: "wir" },
        { selector: '[data-pronoun="ihr"]', key: "ihr" },
        { selector: '[data-pronoun="sie und Sie"]', key: "sie" }
      ];

      rowIds.forEach(({ selector, key }) => {
        const rowElem = document.querySelector(selector);
        if (rowElem) {
          rowElem.addEventListener("click", () => {
            const verbData = verbDataStore[activeVerbKey];
            if (verbData && verbData.plainForms) {
              pronounceText(verbData.plainForms[key]);
            }
          });
        }
      });
    });
  </script>


